# PixiERP Production - erp.pixisys.eu
# Modified to include WebSocket and SSL restoration

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    server_name erp.pixisys.eu e.pixisys.eu;
    client_max_body_size 1000M;

    # Backend API
    location /api/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # WebSocket support
    location /ws/ {
        proxy_pass http://127.0.0.1:8003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade "websocket";
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        
        # Force keepalive
        proxy_socket_keepalive on;
    }

    # Django admin static files
    location ~ ^/(admin|api-auth)/.*\.(?:css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://localhost:8003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Media files
    location /media/ {
        alias /home/ceze/pixisys/pixierp/media/;
        expires 7d;
    }

    # Frontend - Production build
    location / {
        root /home/ceze/pixisys/pixierp/frontend/build;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    # Static files from build
    location /static/ {
        root /home/ceze/pixisys/pixierp/frontend/build;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Logging
    access_log /var/log/nginx/erp.pixisys.eu-access.log;
    error_log /var/log/nginx/erp.pixisys.eu-error.log;

    # SSL Config (Restored)
    listen 443 ssl; 
    ssl_certificate /etc/letsencrypt/live/erp.pixisys.eu-0001/fullchain.pem; 
    ssl_certificate_key /etc/letsencrypt/live/erp.pixisys.eu-0001/privkey.pem; 
    include /etc/letsencrypt/options-ssl-nginx.conf; 
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; 
}

server {
    if ($host = erp.pixisys.eu) {
        return 301 https://$host$request_uri;
    } 
    listen 80;
    server_name erp.pixisys.eu e.pixisys.eu;
    return 404; 
}
