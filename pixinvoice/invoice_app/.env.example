# Django alapértelmezett beállítások
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production
DEBUG=True

# Engedélyezett host-ok (vesszővel elválasztva, szóköz nélkül)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Adatbázis beállítások (PostgreSQL)
DB_NAME=pixinvoice_db
DB_USER=pixinvoice_user
DB_PASSWORD=pixinvoice2026
DB_HOST=localhost
DB_PORT=5432

# SMTP email beállítások (opcionális)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=1
SMTP_FROM=noreply@your-domain.com

# IMAP beállítások (opcionális, sent folder)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_SENT_FOLDER=INBOX.Sent

# NAV API beállítások (ezek az adatbázisban is tárolhatók)
# NAV_API_BASE_URL=https://api.onlineszamla.nav.gov.hu/invoiceService/v3
# NAV_TECH_USER=...
# NAV_TECH_PASSWORD=...
# NAV_SIGNATURE_KEY=...
# NAV_EXCHANGE_KEY=...

# Alkalmazás URL-ek
FRONTEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:4001
