# Example environment variables
# Copy to .env and fill in sensitive values

# Django
SECRET_KEY=change-me
DEBUG=True

# Frontend base URL used in password reset emails
FRONTEND_BASE_URL=http://localhost:3000

# Emergency access domain (used by generate_emergency_access command)
# Dev: http://localhost:3000, Prod: https://erp.pixisys.eu or https://te.pixisys.eu
EMERGENCY_DOMAIN=http://localhost:3000

# Email (SMTP) - required for password reset emails in production
# In DEBUG=True or if EMAIL_HOST is empty, Django will use console email backend.
DEFAULT_FROM_EMAIL=no-reply@pixisys.eu
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Comma-separated lists for production (add your domain, e.g. erp.pixisys.eu, te.pixisys.eu)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,te.pixisys.eu
CSRF_TRUSTED_ORIGINS=https://te.pixisys.eu,http://te.pixisys.eu
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://te.pixisys.eu,http://te.pixisys.eu

# CORS
FRONTEND_URL=http://localhost:3000

# PIXINVOICE / NAV lookup
# Base URL can be left default; only API key is required
PIXINVOICE_API_BASE=https://api.pixinvoice.hu
PIXINVOICE_API_KEY=your_api_key_here
